{
  // First-phase run: 48 atoms (three 2x2x1 FCC clusters in a row), argon-like LJ, NVE. Reduced LJ units.
  // Cold row of three compact 16-atom FCC clusters (2x2x1 cells each), in a straight line along x with a
  // 1 sigma gap between cluster boundaries. Lattice spacing is the Lennard-Jones minimum (density 1.0 gives
  // nearest neighbours at 2^(1/6) sigma). The row is centred in a large empty box (168 x 84 x 84 sigma), so
  // it never meets its periodic images. Low temperature, so the atoms vibrate about their sites rather than
  // evaporate. Reduced LJ units.
  "cells": [2, 2, 1],
  "density": 1.0,
  "box": [168, 84, 84],
  "clusterCount": 3,
  "clusterGap": 1.0,
  "temperature": 0.05,
  "timestep": 0.005,
  "steps": 20000,
  "seed": 12345,
  "cutoff": 2.5,
  "trajectoryEvery": 10,
  "logEvery": 1000,
  "elements": ["Ar"],
  "output": "../out/argon-8.traj"
}
