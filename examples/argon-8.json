{
  // First-phase run: 8 atoms (2x1x1 FCC cells), argon-like LJ, NVE. Reduced LJ units.
  // Cold, compact 8-atom FCC cluster at the Lennard-Jones minimum spacing (density 1.0 gives nearest
  // neighbours at 2^(1/6) sigma), centred in a large empty box (168 x 84 x 84 sigma) so it never meets
  // its periodic images. Starts close to equilibrium. Temperature is low, so the atoms vibrate about
  // their lattice sites rather than evaporate. Reduced LJ units.
  "cells": [2, 1, 1],
  "density": 1.0,
  "box": [168, 84, 84],
  "temperature": 0.05,
  "timestep": 0.005,
  "steps": 20000,
  "seed": 12345,
  "cutoff": 2.5,
  "trajectoryEvery": 10,
  "logEvery": 1000,
  "elements": ["Ar"],
  "output": "../out/argon-8.traj"
}
